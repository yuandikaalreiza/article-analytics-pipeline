# Copy to .env for a new checkout, then replace the password placeholder.
# These database and user settings initialize an empty PostgreSQL volume only.
POSTGRES_DB=article_source
POSTGRES_USER=article_dev
POSTGRES_PASSWORD=replace_with_your_local_password

# Host port; PostgreSQL still uses port 5432 inside its container.
POSTGRES_PORT=5432

# Python runs on the host and connects through the published local port.
POSTGRES_HOST=127.0.0.1

# ClickHouse container settings and localhost HTTP port.
CLICKHOUSE_DB=article_analytics
CLICKHOUSE_USER=clickhouse_dev
CLICKHOUSE_PASSWORD=replace_with_your_local_password
CLICKHOUSE_HTTP_PORT=8123
